+// sqwen: env-gated census of *actually dispatched* kernels. Each entry is either a
+// standalone op name ("MUL_MAT") or a fused group ("MUL_MAT_ID+GLU,..."). Used to pick
+// graph-level fusion targets from measurements instead of from node counts.
+static bool ggml_cuda_census_enabled() {
+    static const bool enabled = [] {
+        const char * e = getenv("SQWEN_KERNEL_CENSUS");
+        return e != nullptr && atoi(e) != 0;
+    }();
+    return enabled;
+}
+
+static std::map<std::string, size_t> & ggml_cuda_census_map() {
+    static std::map<std::string, size_t> census;
+    return census;
+}
+
+// per-compute-call loop iteration counter (reset at the top of graph_compute)
+static size_t g_census_iters = 0;
+
+static void ggml_cuda_census_print(const ggml_cgraph * cgraph) {
+    if (!ggml_cuda_census_enabled()) {
+        return;
+    }
+    static size_t calls = 0;
+    calls++;
+    auto & census = ggml_cuda_census_map();
+    size_t total = 0;
+    for (const auto & kv : census) {
+        total += kv.second;
+    }
+    fprintf(stderr, "[census] call#%zu n_nodes=%d iters=%zu dispatched=%zu (%zu distinct)\n",
+            calls, cgraph->n_nodes, g_census_iters, total, census.size());
+    std::vector<std::pair<size_t, std::string>> rows;
+    rows.reserve(census.size());
+    for (const auto & kv : census) {
+        rows.emplace_back(kv.second, kv.first);
+    }
+    std::sort(rows.begin(), rows.end(), [](const auto & a, const auto & b) { return a.first > b.first; });
+    for (const auto & r : rows) {
+        fprintf(stderr, "[census]   %-40s %zu\n", r.second.c_str(), r.first);
+    }
+    census.clear();
+}
